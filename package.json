{
  "name": "zigeditor",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsup --config tsup.worker.ts && tsup",
    "typecheck": "tsc --noEmit",
    "proof": "tsx proof/host-proof.mjs",
    "dev": "pnpm build && pnpm exec concurrently -k -n lib,demo \"pnpm exec tsup --watch\" \"pnpm --filter example dev\""
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.12.3"
}
